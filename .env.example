# ============================================
# Server Configuration（服务器配置）
# ============================================
# 服务器端口号，默认 3000
PORT=3000
# API 密钥，用于验证请求合法性（请替换为随机字符串）
API_KEY=replace-with-a-random-api-key
# CORS 跨域白名单，* 表示允许所有来源
CORS_ORIGIN=*

# ============================================
# Multi-User Authentication（多用户认证配置）
# ============================================
# 必需配置，用于生成 userId 和加密每个用户的 JW 密码
# 上线后请勿修改，否则旧的 userId 和加密密码将无法复用
APP_SECRET=replace-with-a-long-random-secret-at-least-16-chars

# ============================================
# Login Configuration（登录配置）
# ============================================
# 登录模式：direct 为已验证的教学子系统登录，unified 作为备用/研究路径
JW_LOGIN_MODE=direct
# 是否使用 OCR 识别验证码（1=启用，0=禁用）
JW_USE_OCR=1
# 验证码最大尝试次数
JW_CAPTCHA_ATTEMPTS=1
# OCR 最低置信度阈值（0 表示接受任何结果）
JW_OCR_MIN_CONFIDENCE=0
# 验证码有效时间（秒）
JW_CAPTCHA_TTL_SECONDS=180
# JW 会话有效期（分钟）
JW_SESSION_TTL_MINUTES=20

# ============================================
# Multi-User Storage（多用户存储配置）
# ============================================
# 用户数据目录，存储加密后的用户凭证
USER_DATA_DIR=.data/users
# 课程表缓存根目录，每个用户独立子目录
JW_SCHEDULE_CACHE_ROOT=.cache/users
# 缓存有效期（秒）
JW_CACHE_TTL_SECONDS=600
# 是否保存原始响应数据（1=保存，0=不保存）
JW_SAVE_RAW=0

# ============================================
# Batch Defaults（批量获取默认值）
# ============================================
# 学期开始日期
JW_SEMESTER_START=2026-03-02
# 学期总周数
JW_TOTAL_WEEKS=19

# ============================================
# Request Pacing（请求间隔配置）
# ============================================
# 基础延迟时间（毫秒），用于控制爬取频率
JW_TIMEOUT_MS=8000
JW_MAX_RETRIES=1
JW_RETRY_BACKOFF_MS=600
JW_BASE_DELAY_MS=250
# 随机抖动时间（毫秒），用于避免请求过于规律
JW_JITTER_MS=150
# 是否输出详细日志（1=详细，0=简洁）
JW_VERBOSE=0
