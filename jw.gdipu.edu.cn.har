            "mimeType": "text/html",
            "text": "\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<form target=\"hideFrame\" method=\"post\" name=\"Form1\" id=\"Form1\"\r\n\t  action=\"\" >\r\n\t<table id=\"tab1\" class=\"table table-bordered table-hover table-striped kb_table\" style=\"overflow: scroll;height: 95%;\">\r\n\t\t<thead>\r\n\t\t<tr>\r\n\t\t\t<th style=\"width: 14%;\">周/节次</th>\r\n\t\t\t<th style=\"width: 12%;\">星期一</th>\r\n\t\t\t<th style=\"width: 12%;\">星期二</th>\r\n\t\t\t<th style=\"width: 12%;\">星期三</th>\r\n\t\t\t<th style=\"width: 12%;\">星期四</th>\r\n\t\t\t<th style=\"width: 12%;\">星期五</th>\r\n\t\t\t<th style=\"width: 12%;\">星期六</th>\r\n\t\t\t<th style=\"width: 12%;\">星期日</th>\r\n\t\t</tr>\r\n\t\t</thead>\r\n\t\t<tbody>\r\n\t\t\r\n\r\n\t\t\r\n\t\t\r\n\r\n\t\t\r\n\r\n\t\t</tbody>\r\n\t</table>\r\n\t\r\n\t\r\n</form>\r\n\r\n\r\n<iframe name=\"hideFrame\"  id=\"hideFrame\" style=\"display:none\"></iframe>\r\n<style>\r\n\t#tooltip{position:absolute;z-index:9999;display:none;padding:4px 8px;border:1px solid rgba(255,255,255,0.25);border-radius:3px;background-color:#333333;filter:alpha(Opacity=80); opacity: 0.8;color:#fff;text-align:left;font-size:16px;}\r\n\t#tooltip:before{position:absolute;top:-6px;left:15px;width:0;height:0;border:6px dashed #333333;border-top:0;color:#fff;content:' ';line-height:0;border-bottom-style:solid;border-left-color:transparent;border-right-color:transparent;}\r\n</style>\r\n<script type=\"text/javascript\">\r\n\t\r\n\t$(\"#li_showWeek\").html(\"当前登录已失效，请重新登录！\");\r\n\t\r\n\t\r\n\t\r\n\t$(\"#li_showWeek\").html(\"<span class=\\\"main_text main_color\\\">当前日期不在教学周历内</span>\");\r\n\t\r\n\t\r\n\t\r\n\r\n\t$(function(){\r\n\t\tvar x=-15;//title显示层x轴偏移量\r\n\t\tvar y=30;//title显示层y轴偏移量\r\n\t\t$(\"p\").mouseover(function(e){//\r\n\t\t\t// 对所有td元素增加鼠标移入移出事件 //edit by wangwei 2018.10.31 此处修改为对所有P标签增加移入移出事件\r\n\t\t\tthis.myTitle=this.title;\r\n\t\t\tthis.title=\"\";\r\n\t\t\tif(this.myTitle != \"\"){\r\n\t\t\t\tvar tooltip=\"<div id='tooltip'>\"+this.myTitle+\"</div>\"; //创建DIV元素\r\n\t\t\t\t$(\"body\").append(tooltip); //追加到文档中\r\n\t\t\t\t$(\"#tooltip\").css({\"top\": (e.pageY+y) + \"px\",\"left\": (e.pageX+x) + \"px\"}).show();     //设置X Y坐标， 并且显示\r\n\t\t\t}\r\n\t\t}).mouseout(function(){\r\n\t\t\tthis.title=this.myTitle;\r\n\t\t\t$(\"#tooltip\").remove(); //移除\r\n\t\t}).mousemove(function(e){\r\n\t\t\t$(\"#tooltip\").css({\"top\": (e.pageY+y) + \"px\",\"left\": (e.pageX+x) + \"px\"});\r\n\t\t})\r\n\t})\r\n\r\n\t\r\n\r\n\r\n\r\n\r\n\r\n\tfunction checkInfo(jx0408id,kssj,jssj){\r\n\t\tvar shareUrl =\"\";\r\n\r\n\t\tvar isyx = false;\r\n\t\tvar  urlinfo = \"/jsxsd/kbxx/isYxMeetingV2?jx0408id=\"+jx0408id+\"&kssj=\"+kssj+\"&jssj=\"+jssj;\r\n\t\t$.ajax({\r\n\t\t\ttype : \"GET\",\r\n\t\t\tasync:false,\r\n\t\t\turl : urlinfo,\r\n\t\t\tdataType: \"json\",\r\n\t\t\tsuccess:function(text) {\r\n\t\t\t\tif(text!=null&&text!=\"\"){\r\n\t\t\t\t\tshareUrl = text;\r\n\t\t\t\t\tisyx = true;\r\n\t\t\t\t}else{\r\n\t\t\t\t\tisyx = false;\r\n\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\terror:function() {\r\n\t\t\t\tisyx = false;\r\n\t\t\t}\r\n\t\t});\r\n\t\tif(!isyx){\r\n\t\t\talert(\"课堂连接已失效！\");\r\n\t\t\tparent.window.location.reload();\r\n\t\t\treturn false;\r\n\t\t}else{\r\n\t\t\twindow.open(shareUrl);\r\n\t\t}\r\n\r\n\t}\r\n\tfunction createMeeting(jx0408id,kcjc,kssj,jssj,rs){\r\n\t\t//判断有无连排课堂，有的话需要修改传入的开始结束时间\r\n\r\n\t\tdocument.Form1.target=\"hideFrame\";\r\n\t\twindow.Form1.action=\"/jsxsd/kbxx/creatMeetingV2?jx0408id=\"+jx0408id+\"&kcjc=\"+kcjc+\"&kssj=\"+kssj+\"&jssj=\"+jssj+\"&rs=\"+rs;\r\n\t\twindow.Form1.submit();\r\n\t}\r\n\r\n</script>"
