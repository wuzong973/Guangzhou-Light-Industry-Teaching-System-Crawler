\t\t\r\n\r\n\t\t$(\".has-dropdown > a\").on(\"mouseover\", function(e){\r\n\t\t\t$(\".firstLevelMenu\").stop();\r\n\t\t\t$(\".firstLevelMenu\").slideDown();\r\n\t\t}).on(\"mouseleave\", function(e){\r\n\t\t\tsetTimeout(function(){\r\n\t\t\t\t$(\".firstLevelMenu\").stop();\r\n\t\t\t\t$(\".cy_icon li:hover\").length == 0 && $(\".firstLevelMenu\").slideUp();\r\n\t\t\t}, 100);\r\n\t\t});\r\n\t\t$(\".firstLevelMenu\").on(\"mouseover\", function(e){\r\n\r\n\t\t}).on(\"mouseleave\", function(e){\r\n\t\t\tsetTimeout(function(){\r\n\t\t\t\t$(\".has-dropdown a:hover\").length == 0 && $(\".firstLevelMenu\").slideUp();\r\n\t\t\t}, 100);\r\n\t\t});\r\n\t});\r\n\t\r\n\r\n\r\n\r\n\tfunction LogoutGLD(){\r\n\t\tvar userid = '2025220502332';\r\n\t\tdocument.getElementById(\"loginForm1\").action = \"http://47.115.158.249/Logon.do?method=logoutFromJsxsd\";\r\n\t\tdocument.getElementById(\"useraccount\").value = userid;\r\n\t\tdocument.getElementById(\"loginForm1\").submit();\r\n\t}\r\n\r\n\t\r\n</script>\r\n\r\n\r\n<script>\r\n\r\n\t//搜索框\r\n\tvar menuval = \"\";\r\n\tvar text = document.getElementById('findMenu');\r\n\tvar search = document.getElementsByClassName('search')[0];\r\n\tvar oul = document.querySelector(\".search ul\");\r\n\r\n\t$('body').click(function(e){\r\n\t\tif($(e.target).attr('class')!='menuCodeUrl'){\r\n\t\t\toul.innerHTML=\"\";\r\n\t\t}\r\n\t});\r\n\r\n\t$('.leftsidebar').click(function(e){\r\n\t\tif($(e.target).attr('class')!='menuCodeUrl'){\r\n\t\t\toul.innerHTML=\"\";\r\n\t\t}\r\n\t});\r\n\r\n\r\n\t$('.tabs-header').click(function(e){\r\n\t\toul.innerHTML=\"\";\r\n\t});\r\n\r\n\r\n\t// 每次点击键盘\r\n\ttext.onkeyup = function(){\r\n\r\n\t\tif(menuval == this.value || this.value == \"\"){\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tdisplay_Menu(this);\r\n\t}\r\n\r\n\ttext.onfocus=function(){\r\n\t\tif(this.value == \"\"){\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tdisplay_Menu(this);\r\n\t}\r\n\tfunction display_Menu(node){\r\n\r\n\t\t// 获取输入框里面的内容\r\n\t\tvar val = node.value;\r\n\t\tmenuval = val;\r\n\t\t// 如果输入框中不为空，就让联想列表出现，否则消失\r\n\t\tsearch.style.display=this.value!=\"\"?\"block\":\"none\";\r\n\t\t$.ajax({\r\n\t\t\turl:\"/jsxsd/jspyfa/findMenuByQxCode\",\r\n\t\t\ttype:\"POST\",\r\n\t\t\tsync:true,\r\n\t\t\tdata:{\"findname\":val},\r\n\t\t\tsuccess:function(result){\r\n\t\t\t\tvar data = JSON.parse(result);\r\n\t\t\t\tif(\"1\" == data.code){\r\n\t\t\t\t\t//清空\r\n\t\t\t\t\toul.innerHTML=\"\";\r\n\t\t\t\t\tvar lis = data.lists;\r\n\t\t\t\t\t$.each(lis,function(idx,elem){\r\n\t\t\t\t\t\tvar fucecode = elem.fucecode;\r\n\t\t\t\t\t\tvar fuceresource = elem.fuceresource;\r\n\t\t\t\t\t\tvar fucename = elem.fucename;\r\n\t\t\t\t\t\tvar lis = document.createElement(\"li\");\r\n\t\t\t\t\t\tlis.title=fucename;\r\n\t\t\t\t\t\tlis.setAttribute(\"onclick\",\"showMenuBycode_bjkjdx(\\\"\"+fucecode+\"\\\",\\\"\"+fuceresource+\"\\\",\\\"\"+fucename+\"\\\")\");\r\n\t\t\t\t\t\tlis.className=\"searchli menuCodeUrl\";\r\n\t\t\t\t\t\tlis.style.textAlign=\"center\";\r\n\t\t\t\t\t\tlis.style.width=\"150px\";\r\n\t\t\t\t\t\tlis.style.height=\"20px\";\r\n\t\t\t\t\t\tlis.style.lineHeight=\"20px\";\r\n\t\t\t\t\t\tlis.innerHTML = fucename;\r\n\t\t\t\t\t\toul.appendChild(lis);\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\r\n\tfunction showMenuBycode_bjkjdx(fucecode,resource,fucename){\r\n\t\tvar twoLevel = fucecode.substring(0,fucecode.lastIndexOf('_'));\r\n\t\tvar oneLevel = twoLevel.substring(0,twoLevel.lastIndexOf('_'));\r\n\t\t$(\"#findMenu\").val(fucename);\r\n\t\t//清空\r\n\t\toul.innerHTML=\"\";\r\n\t\t//跳转\r\n\t\tkjcdShow_bjkjdx(oneLevel,twoLevel,fucecode,resource,fucename);\r\n\r\n\t}\r\n\r\n\r\n\tdocument.onkeydown = function(){\r\n\t\tif(window.event.keyCode==13){\r\n\t\t\tvar firstli = $(\"#searchul\").find(\"li\").eq(0);\r\n\t\t\tfirstli.click();\r\n\t\t}\r\n\t}\r\n\r\n\tvar hideid = \"0\";\r\n\r\n\t/**\r\n\t *\r\n\t * @param id\r\n\t */\r\n\tfunction showli(id) {\r\n\t\t$(\".sidebar-menu .\" + hideid).css('background', '#ffffff');\r\n\t\t$(\".sidebar-menu .\" + hideid + \" i\").css('color', '#004A99');\r\n\t\t$(\".sidebar-menu .\" + hideid + \" span\").css('color', '#004A99');\r\n\r\n\t\t$(\".sidebar-menu .\" + id).css('background', '#004A99');\r\n\t\t$(\".sidebar-menu .\" + id + \" i\").css('color', '#ffffff');\r\n\t\t$(\".sidebar-menu .\" + id + \" span\").css('color', '#ffffff');\r\n\r\n\t\thideid = id;\r\n\t}\r\n</script>\r\n<!--动态标签菜单-->\r\n<script type=\"text/javascript\">\r\n\tvar tabs = document.getElementsByClassName(\"tab\");\r\n\tfor (var i = 0; i < tabs.length; i++) {\r\n\t\ttabs[i].addEventListener(\"click\", func2, false);\r\n\t}\r\n\tfunction func2(event) {\r\n\t\tfor (var i = 0; i < tabs.length; i++) {\r\n\t\t\ttabs[i].classList.remove(\"active\");\r\n\t\t}\r\n\t\tevent = event ? event : window.event;\r\n\t\tvar obj = event.srcElement ? event.srcElement : event.target;\r\n\t\tconsole.log(obj.classList.add(\"active\"));\r\n\t}\r\n</script>\r\n<!--tab选项卡-->\r\n<script>\r\n\tvar tas = document.getElementsByClassName(\"tabarrow\");\r\n\tfor (var i = 0; i < tas.length; i++) {\r\n\t\tconsole.log(tas[i].classList);\r\n\t}\r\n\tlayui.use(\"element\", function () {\r\n\t\tvar element = layui.element;\r\n\r\n\t\t//获取hash来切换选项卡，假设当前地址的hash为lay-id对应的值\r\n\t\tvar layid = location.hash.replace(/^#test1=/, \"\");\r\n\t\telement.tabChange(\"test1\", layid); //假设当前地址为：http://a.com#test1=222，那么选项卡会自动切换到“发送消息”这一项\r\n\r\n\t\t//监听Tab切换，以改变地址hash值\r\n\t\telement.on(\"tab(test1)\", function () {\r\n\t\t\tlocation.hash = \"test1=\" + this.getAttribute(\"lay-id\");\r\n\t\t});\r\n\t});\r\n</script>\r\n<script type=\"text/javascript\">\r\n\tfunction checkPerson(res) {\r\n\t\tif (res == 0) {\r\n\t\t\tdocument.getElementById(\"alterIframe\").src = \"../pages/demo.html\";\r\n\t\t} else if (res == 1) {\r\n\t\t\tdocument.getElementById(\"alterIframe\").src = \"../pages/xsxkmd.html\";\r\n\t\t}\r\n\t}\r\n</script>\r\n</html>"
