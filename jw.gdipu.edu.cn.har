          "content": {
            "size": 41045,
            "mimeType": "text/html",
            "text": "\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n<head>\r\n\t<meta charset=\"utf-8\">\r\n\t<title>教学一体化服务平台</title>\r\n\t<script type=\"text/javascript\"\r\n\t\t\tsrc=\"/jsxsd/js/jquery-min.js\"\r\n\t\t\tlanguage=\"javascript\"></script>\r\n\t<script type=\"text/javascript\"\r\n\t\t\tsrc=\"/jsxsd/js/common.js\"\r\n\t\t\tlanguage=\"javascript\"></script>\r\n\t<script type=\"text/javascript\"\r\n\t\t\tsrc=\"/jsxsd/js/iepngfix_tilebg.js\"\r\n\t\t\tlanguage=\"javascript\"></script>\r\n\t<link\r\n\t\t\thref=\"/jsxsd/framework/images/common.css\"\r\n\t\t\trel=\"stylesheet\" type=\"text/css\" />\r\n\r\n\t<link\r\n\t\t\thref=\"/jsxsd/framework/student/css/css.css\"\r\n\t\t\ttype=\"text/css\" rel=\"stylesheet\" />\r\n\t<script type=\"text/javascript\"\r\n\t\t\tsrc=\"/jsxsd/framework/student/js/ui.js\"></script>\r\n\t<script type=\"text/javascript\"\r\n\t\t\tsrc=\"/jsxsd/framework/student/js/laydate/laydate.js\"></script>\r\n\t<script type=\"text/javascript\"\r\n\t\t\tsrc=\"/jsxsd/framework/student/js/index.js\"></script>\r\n\t<script type=\"text/javascript\" src=\"/jsxsd/js/artDialog/artDialog.min.js\"></script>\r\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/jsxsd/css/reset.css\">\r\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/jsxsd/css/sidebar-menu.css\">\r\n\t\r\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/jsxsd/css/style01.css\"/>\r\n\t\r\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/jsxsd/css/style.css\">\r\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/jsxsd/js/artDialog/skin/chrome/chrome.css\" />\r\n\t<style>\r\n\r\n\t\t\r\n\t\t.main-sidebar {\r\n\t\t\tposition: absolute;\r\n\t\t\ttop: 62px;\r\n\t\t\tleft: 0;\r\n\t\t\theight: 100%;\r\n\t\t\tmin-height: 100%;\r\n\t\t\twidth: 160px;\r\n\t\t\tz-index: 10;\r\n\t\t}\r\n\t\t\r\n\t\t.cy_iconIE li {\r\n\t\t\tcolor: #fff;\r\n\t\t\ttext-align: center;\r\n\t\t\tcursor: pointer;\r\n\t\t\tfloat: left;\r\n\t\t}\r\n\r\n\t\t.cy_iconIE li {\r\n\t\t\tcolor: #fff;\r\n\t\t\ttext-align: center;\r\n\t\t\tcursor: pointer;\r\n\t\t}\r\n\r\n\t\t.cy_iconIE li i {\r\n\t\t\tfont-size: 24px;\r\n\t\t\tpadding: 10%;\r\n\t\t\tcolor: #178fe6;\r\n\t\t\tborder-radius: 5px;\r\n\t\t\tbackground: #fff;\r\n\t\t\tborder: 1px solid #ddd;\r\n\t\t}\r\n\r\n\t\t.dropdownIe {\r\n\t\t\tposition: absolute;\r\n\t\t\tbackground-color: #fff;\r\n\t\t\tleft: 150px;\r\n\t\t\ttop: 80px;\r\n\t\t\tbox-shadow: 0 5px 10px rgba(0, 0, 0, 0.3);\r\n\t\t\topacity: 0;\r\n\t\t}\r\n\t\t.cy_iconIE li:hover i{\r\n\t\t\tborder: 1px solid #178fe6;\r\n\t\t\tbox-shadow: 0 1px 1px #178fe6;\r\n\t\t}\r\n\t\t.cy_iconIE li span {\r\n\t\t\tdisplay: block;\r\n\t\t}\r\n\t\t.cy_iconIE li:hover span{\r\n\t\t\tcolor:#178fe6;\r\n\t\t\ttext-decoration: underline;\r\n\t\t}\r\n\t\t.hide {\r\n\t\t\tdisplay: none;\r\n\t\t}\r\n\t\t.first-sidebar {\r\n\t\t\tmargin: 0;\r\n\t\t\tmargin-left: 0px;\r\n\t\t\tfont-size: 14px;\r\n\t\t\ttransition: margin .5s;\r\n\t\t\t-moz-transition: margin .5s;\r\n\t\t\t-webkit-transition: margin .5s;\r\n\t\t\t-o-transition: margin .5s;\r\n\t\t\tbackground: linear-gradient(180deg,#36bafd,#206ca2);\r\n\t\t}\r\n\t\t.first-sidebar, .touch {\r\n\t\t\tposition: fixed;\r\n\t\t\ttop: 60px;\r\n\t\t\tleft: 0;\r\n\t\t\twidth: 160px;\r\n\t\t\theight: 1020px;\r\n\t\t\tborder-right: 2px solid #d9eeff;\r\n\t\t\tbackground-color: #30A5E4;\r\n\t\t}\r\n\t\t.touch {\r\n\t\t\twidth: 10px;\r\n\t\t\theight: 800px;\r\n\t\t\tborder-right: none;\r\n\t\t\tbackground: transparent;\r\n\t\t}\r\n\t\t\r\n\t\t.first-menu {\r\n\t\t\tlist-style: none;\r\n\t\t\tmargin: 0;\r\n\t\t\tpadding: 0;\r\n\t\t}\r\n\t\t.first-menu > li:hover {\r\n\t\t\tcolor: #30A5E4;\r\n\t\t\tbackground: #fbfbfb;\r\n\t\t\tborder-left: 3px solid #34b8fc;\r\n\t\t}\r\n\t\t.first-menu > li {\r\n\t\t\tposition: relative;\r\n\t\t\tmargin: 0;\r\n\t\t\tpadding: 0;\r\n\t\t\tline-height: 26px;\r\n\t\t}\r\n\r\n\t\t\r\n\r\n\r\n\r\n\t\t\r\n\t\t.first-menu > li > .fa {\r\n\t\t\twidth: 20px;\r\n\t\t}\r\n\r\n\r\n\t\t\r\n\t\t.first-menu > li .maintext {\r\n\t\t\tcolor: #fff;\r\n\t\t\tfont-weight: normal;\r\n\t\t}\r\n\t\t\r\n\t\t\r\n\t\t.first-menu > li:hover .maintext {\r\n\t\t\tcolor: #34b8fc;\r\n\t\t}\r\n\t\t\r\n\t\t.firstLevelMenu {\r\n\t\t\tposition: absolute;\r\n\t\t\tleft: 160px;\r\n\t\t\ttop: 2px;\r\n\t\t\tbackground-color: #fff;\r\n\t\t\t-moz-box-shadow: 5px 5px 5px #999999;\r\n\t\t\tbox-shadow: 5px 5px 5px #999999;\r\n\t\t}\r\n\t\t.tabs-wrap{\r\n\t\t\twidth:90%\r\n\t\t}\r\n\t\t\r\n\r\n\t\t\r\n\t</style>\r\n\r\n\t<script>\r\n\r\n\t\twindow.onload=function(){\r\n\t\t\t//$(\"#mainNorthPanle\").css(\"background-color\",\"red\");\r\n\t\t\tvar sfqf=\"\";\r\n\t\t\tvar qfje=\"\";\r\n\t\t\tif(sfqf==\"yes\"){\r\n\t\t\t\talert(\"欠\"+qfje+\"￥学费，请到财务处缴费\");\r\n\t\t\t}\r\n\t\t}\r\n\t\tfunction LogoutGLD(){\r\n\t\t\tvar userid = '2025220502332';\r\n\t\t\tdocument.getElementById(\"loginForm1\").action = \"http://47.115.158.249/Logon.do?method=logoutFromJsxsd\";\r\n\t\t\tdocument.getElementById(\"useraccount\").value = userid;\r\n\t\t\tdocument.getElementById(\"loginForm1\").submit();\r\n\t\t}\r\n\t</script>\r\n\r\n\r\n</head>\r\n<body>\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/jsxsd/css/reset.css\">\r\n<link rel=\"stylesheet\" href=\"/jsxsd/js/easyui/themes/default/easyui.css\" type=\"text/css\"></link>\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/jsxsd/css/sidebar-menu.css\">\r\n\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/jsxsd/css/style01.css\"/>\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/jsxsd/css/style.css\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n\t\t\r\n\t<div id=\"mainNorthPanle\" data-options=\"region:'north',border: false\" style=\"border: 0; padding: 0; height: 60px;\">\r\n\t\t<header>\r\n\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t<ul class=\"nav ace-nav pull-right\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\t\t<li  onclick=\"xxtz()\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\t<span class=\"glyphicon glyphicon-user\"></span>\r\n\t\t\t\t\t<span class=\"glyphicon-class\">消息通知(\r\n\t\t\t\t<span  style=\"color: #ed5736; font-weight: bold\" id=\"xxtz\" >14</span>&nbsp;)\r\n\t\t\t\t</span>\r\n\t\t\t\t\r\n\t\t\t</li>\r\n\t\t\t\t<li id=\"btn_gotoGrzx\">\r\n\t\t\t\t\t<span class=\"glyphicon glyphicon-user\"></span>\r\n\t\t\t\t\t<span class=\"glyphicon-class ckgrxx\"><a   style=\"color: white\">欧阳志鑫</a></span>\r\n\t\t\t\t</li>\r\n\t\t\t\t<li id=\"btn_userLogout\"\r\n\t\t\t\t\tonclick=\"javascript:if(confirm('您确定退出系统？')){LogoutGLD();Logout('/jsxsd');}\">\r\n\t\t\t\t\t<span class=\"glyphicon glyphicon-off\"></span>\r\n\t\t\t\t\t<span class=\"glyphicon-class\">退出</span>\r\n\t\t\t\t</li>\r\n\t\t\t</ul>\r\n\r\n\r\n\r\n\t\t</header>\r\n\r\n\t</div>\r\n\t\t\r\n\t<form action = \"http://47.115.158.249/Logon.do?method=logonFromJsxsd\"  method=\"post\" id=\"loginForm1\" name=\"loginForm1\">\r\n\t\t<input type = \"hidden\" id=\"view\" name=\"view\" />\r\n\t\t<input type = \"hidden\" id=\"useraccount\" name=\"useraccount\" />\r\n\t\t<input type = \"hidden\" id=\"ticket\" name=\"ticket\" />\r\n\t</form>\r\n\r\n\r\n\t\t\r\n\t<div id=\"mainWestPanle\" data-options=\"region:'west',border: false\" style=\"padding: 0; width: 160px;\">\r\n\t\t<div class=\"leftsidebar\">\r\n\r\n\r\n\t\t\t\r\n\t\t\t<div id=\"onesidebar\" class=\"first-sidebar\" style=\"z-index: 1500; margin-left: 0;\">\r\n\t\t\t\t<div class=\"sidebar\">\r\n\t\t\t\t\t<ul class=\"first-menu\">\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<li data-code=\"NEW_XSD_WDZM\" onclick=\"$('#onesidebar').css('margin-left', '-160px');showMenuErji(this);\">\r\n\t\t\t\t\t\t\t<i class=\"fa fa-stack\"></i>\r\n\t\t\t\t\t\t\t<span class=\"maintext\">我的桌面</span>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<li data-code=\"NEW_XSD_XJCJ\" onclick=\"$('#onesidebar').css('margin-left', '-160px');showMenuErji(this);\">\r\n\t\t\t\t\t\t\t<i class=\"fa fa-stack\"></i>\r\n\t\t\t\t\t\t\t<span class=\"maintext\">学籍成绩</span>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<li data-code=\"NEW_XSD_PYGL\" onclick=\"$('#onesidebar').css('margin-left', '-160px');showMenuErji(this);\">\r\n\t\t\t\t\t\t\t<i class=\"fa fa-stack\"></i>\r\n\t\t\t\t\t\t\t<span class=\"maintext\">培养管理</span>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<li data-code=\"NEW_XSD_KSBM\" onclick=\"$('#onesidebar').css('margin-left', '-160px');showMenuErji(this);\">\r\n\t\t\t\t\t\t\t<i class=\"fa fa-stack\"></i>\r\n\t\t\t\t\t\t\t<span class=\"maintext\">考试报名</span>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t</ul>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t\r\n\t\t\t<div class=\"touch\" style=\"z-index:50\" onmouseover=\"mouseOver()\"></div>\r\n\r\n\r\n\t\t\t\r\n\t\t\t<div class=\"cd-morph-dropdown\">\r\n\t\t\t\t<nav class=\"main-nav\">\r\n\t\t\t\t\t<ul>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<li class=\"has-dropdown gallery\" data-content=\"about\" style=\"border-bottom: 1px solid #d9eeff;\">\r\n\t\t\t\t\t\t\t<a href=\"javascript:void(0);\">\r\n\t\t\t\t\t\t\t\t<i class=\"glyphicon glyphicon-list\" style=\"font-weight: 100;\"></i>\r\n\t\t\t\t\t\t\t\t<span id=\"main_title\">主菜单</span>\r\n\t\t\t\t\t\t\t\t<span class=\"glyphicon glyphicon-chevron-right\" style=\"font-size: 12px; float: right; line-height: 36px;\"></span>\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t</ul>\r\n\t\t\t\t</nav>\r\n\t\t\t\t<div class=\"firstLevelMenu\" style=\"display: none;\">\r\n\t\t\t\t\t<div class=\"content\" style=\"width: 800px; min-height: 220px;\">\r\n\t\t\t\t\t\t<ul class=\"cy_icon\">\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t<li style=\"width: 100px; margin: 20px 0 10px 0; padding: 0 5px;\" data-code=\"NEW_XSD_WDZM\" onclick=\"showMenuErji(this)\">\r\n\t\t\t\t\t\t\t\t<i class=\"fa-windows\"></i>\r\n\t\t\t\t\t\t\t\t<span class=\"maintext\">我的桌面</span>\r\n\t\t\t\t\t\t\t</li>\