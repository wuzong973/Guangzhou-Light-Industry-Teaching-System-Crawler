t\t\t\t\t\t<li class=\"treeview\" data-code=\"NEW_XSD_XJCJ_WDCJ\" data-parent=\"NEW_XSD_XJCJ\" style=\"display: none;\">\r\n\t\t\t\t\t\t\t\t\t<a href=\"javascript:void(0)\"> <i class=\"\"></i>\r\n\t\t\t\t\t\t\t\t\t\t<span>我的成绩</span>\r\n\t\t\t\t\t\t\t\t\t\t<i class=\"fa-angle-left pull-right\"></i>\r\n\t\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t\t\t<ul class=\"treeview-menu\">\r\n\t\t\t\t\t\t\t\t\t\t\r\n\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t<li data-sjcode=\"NEW_XSD_XJCJ_WDCJ_KCCJCX\"  data-url=\"/kscj/cjcx_frm\">\r\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"javascript:void(0)\"><i class=\"fa fa-circle-o\"></i>课程成绩查询</a>\r\n\t\t\t\t\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\t\t\t\t\r\n\r\n\t\t\t\t\t\t\t\t\t\t\r\n\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t<li data-sjcode=\"NEW_XSD_XJCJ_WDCJ_CJZHSQ\"  data-url=\"/kscj/cjzh_query\">\r\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"javascript:void(0)\"><i class=\"fa fa-circle-o\"></i>成绩置换申请</a>\r\n\t\t\t\t\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\t\t\t\t\r\n\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t</section>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t</aside>\r\n\r\n\t\t</div>\r\n\t</div>\r\n\t\t\r\n\r\n\t\t\r\n\t<div id=\"mainCenterPanle\" data-options=\"region:'center',border: false\" style=\"padding: 0; overflow: hidden;\">\r\n\t\t<div class=\"easyui-layout\" data-options=\"fit:true\">\r\n\t\t\t<div id=\"mainTagPanle\" data-options=\"region:'north',border: false\" style=\"overflow: hidden; padding: 0; height: 30px;margin-left:160px;\">\r\n\t\t\t\t<div class=\"tabs-header\" style=\"width: 100%; border: 0;\">\r\n\t\t\t\t\t<div class=\"tabs-scroller-left\" style=\"display: block; top:0;z-index: 1000;\" onclick=\"leftMove()\"></div>\r\n\t\t\t\t\t<div class=\"tabs-scroller-right\" style=\"display: block; z-index: 1000;top:0;\" onclick=\"rightMove()\"></div>\r\n\t\t\t\t\t<div class=\"tabs-wrap\" style=\"margin-right: 20px;\">\r\n\t\t\t\t\t\t<ul class=\"tabs\" style=\"height: 26px;\">\r\n\t\t\t\t\t\t\t<li class=\"tabs-selected\" data-yjcode=\"mainContent\"  data-index=\"0\">\r\n\t\t\t\t\t\t\t\t<a id=\"tag_grzx\" href=\"javascript:void(0)\" class=\"tabs-inner\" style=\"height: 26px;margin-left:18px; line-height: 26px;\" onclick=\"showMenu('mainContent', '0', this)\">\r\n\t\t\t\t\t\t\t\t\t<span class=\"tabs-title\">个人中心</span>\r\n\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t\r\n\t\t\t<div id=\"mainContentPanle\" data-options=\"region:'center',border: false\" style=\"padding: 0; overflow: hidden;\">\r\n\t\t\t\t<iframe id=\"Frame0\" name=\"Frame0\" src=\"/jsxsd/framework/xsMain_new.jsp?t1=1\" style=\"left: 160px;position: absolute;border: 0; margin: 0; width:90%; height:86%;\"></iframe>\r\n\t\t\t</div>\r\n\t\t\t\r\n\t\t</div>\r\n\t</div>\r\n\t\t\r\n\r\n\t<div id=\"fudong\" style=\"border:1px solid #F5F5F5; width:180px; height:200px; position: absolute; right: 1px; bottom: 1px;;background-color:  #F5F5F5;font-size: 13px;display: none;\">\r\n\t\t<span style=\"font-size: 14px;color: #333;margin-left: 5px;\" ><b>扫描二维码  下载APP</b></span>\r\n\t\t<span style=\"cursor: pointer;text-align: right;float: right;\" onclick=\"closeCode()\" >\r\n\t    \t<img class=\"img-responsive\" alt=\"加载失败\" height=\"18\" width=\"18\" src=\"/jsxsd/css/images/gb.png\" ></center>\r\n\t    </span>\r\n\t\t<center><img class=\"img-responsive\" alt=\"加载失败\" height=\"180\" width=\"180\" src=\"/jsxsd/css/images/codeFrame.png\" ></center>\r\n\t</div>\r\n\r\n</body>\r\n\r\n<script type=\"text/javascript\" src=\"/jsxsd/js/jquery.messager.js\" language=\"javascript\" ></script>\r\n<script type=\"text/javascript\">\r\n\tfunction cd(id) {\r\n\t\tif(id=='1'){\r\n\t\t\t$(\"#Frame0\").attr(\"src\",\"/jsxsd/xskb/xskb_list.do\");\r\n\t\t\t$(\"#grzx\").html(\"学期理论课表\");\r\n\t\t}else if(id=='2'){\r\n\t\t\t$(\"#Frame0\").attr(\"src\",\"/jsxsd/kbxx/jsjy_query\");\r\n\t\t\t$(\"#grzx\").html(\"教室借用申请\");\r\n\t\t}else if(id=='3'){\r\n\t\t\t$(\"#Frame0\").attr(\"src\",\"/jsxsd/xsxk/xklc_list\");\r\n\t\t\t$(\"#grzx\").html(\"学生选课中心\");\r\n\t\t}else{\r\n\t\t\t$(\"#Frame0\").attr(\"src\",\"/jsxsd/framework/xsMain.jsp\");\r\n\t\t\t$(\"#grzx\").html(\"个人中心\");\r\n\t\t}\r\n\t}\r\n\tvar frameWidth = $(window).width()-175;\r\n\tvar framHeight = $(window).height()-$(\".tabs-wrap\").height()-$(\"#mainNorthPanle\").height()-5 +10;\r\n\t//$(\"#Frame0\").width(frameWidth);\r\n\t//$(\"#Frame0\").height(framHeight);\r\n\tvar msg = \"\";\r\n\r\n\t//APP二维码悬浮功能开始\r\n\t//是否启用APP下载二维码\r\n\t\r\n\t\r\n\t$(function() {\r\n\t\tvar timer, scrollTop, sideDiv = $('#fudong').appendTo('body');\r\n\t\t$(window).scroll(function() {\r\n\t\t\ttimer && clearTimeout(timer);\r\n\t\t\tscrollTop = $(this).scrollTop();\r\n\t\t\ttimer = setTimeout(function() {\r\n\t\t\t\tsideDiv.animate({\r\n\t\t\t\t\tbottom:  1 -scrollTop + 'px'\r\n\t\t\t\t}, 600);\r\n\t\t\t}, 200);\r\n\t\t});\r\n\t\tif(\"\"==\"true\"){\r\n\t\t\twindow.open ('/jsxsd/kscj/cjbjg_list', 'newwindow', 'height=9999, width=9999, top=0, left=0, toolbar=no, menubar=no, scrollbars=no, resizable=no,location=no, status=no');\r\n\t\t}\r\n\t});\r\n\r\n\tfunction closeCode(){\r\n\t\t$(\"#fudong\").hide();\r\n\t}\r\n\t//APP二维码悬浮功能结束\r\n</script>\r\n\r\n<script src=\"/jsxsd/js/jquery-min.js\" type=\"text/javascript\"></script>\r\n<script src=\"/jsxsd/js/sidebar-menu.js\" type=\"text/javascript\"></script>\r\n<script type=\"text/javascript\">\r\n\t/**\r\n\t * 切换新版旧版\r\n\t */\r\n\tfunction changeShowtype() {\r\n\t\twindow.location.href = \"/jsxsd/framework/xsMain_old.jsp\";\r\n\t}\r\n\r\n\tfunction xxtz(){\r\n\t\tdocument.getElementById(\"xxtz\").innerHTML=\"0\";\r\n\t\tkjcdShow(\"NEW_XSD_WDZM\",\"NEW_XSD_WDZM_GGLY\",\"NEW_XSD_WDZM_GGLY_XXTZ\",\"/ggly/xxtz_query\",\"消息通知\");\r\n\r\n\t}\r\n\tfunction wblj() {\r\n\t\tkjcdShow(\"NEW_XSD_WDZM\",\"NEW_XSD_WDZM_GGLY\",\"NEW_XSD_WDZM_GGLY_WBLJ\",\"/ggly/wblj_query\",\"学生中心\");\r\n\t}\r\n\tfunction kjcdShow(yjcode, ejcode, sjcode, url, name){\r\n\t\tshowMenuErji($(\".cy_icon > li[data-code='\"+yjcode+\"']\").get(0));\r\n\t\t$(\".sidebar-menu > li[data-code='\"+ejcode+\"']\").addClass(\"active\");\r\n\t\t$(\".sidebar-menu > li[data-code='\"+ejcode+\"']\").find(\".treeview-menu\").show();\r\n\t\t$(\".sidebar-menu > li[data-code='\"+ejcode+\"']\").find(\".treeview-menu > li[data-sjcode='\"+sjcode+\"']\").addClass(\"active\");\r\n\t\t$(\".tabs li.tabs-selected\").find(\".tabs-title\").text(name);\r\n\t\t$(\"#Frame\"+(frameIndex-1)).attr(\"src\", \"/jsxsd\"+url);\r\n\r\n\r\n\t}\r\n\tfunction kjcdShow_bjkjdx(yjcode, ejcode, sjcode, url, name){\r\n\t\tshowMenuErji_bjkjdx($(\".cy_icon > li[data-code='\"+yjcode+\"']\").get(0));\r\n\t\t$(\".layui-tab-title > li[data-code='\"+ejcode+\"']\").addClass(\"active\");\r\n\t\t$(\".layui-tab-title > li[data-code='\"+ejcode+\"']\").find(\".treeview-menu\").show();\r\n\t\t$(\".layui-tab-title > li[data-code='\"+ejcode+\"']\").find(\".treeview-menu > li[data-sjcode='\"+sjcode+\"']\").addClass(\"active\");\r\n\t\t$(\".layui-tab-title li.ffc\").find(\".tabs-title\").text(name);\r\n\t\t$(\"#Frame\"+(frameIndex-1)).attr(\"src\", \"/jsxsd\"+url);\r\n\r\n\r\n\t}\r\n\tfunction mouseOver(){\r\n\t\t$(\"#onesidebar\").css(\"margin-left\", \"0px\");\r\n\t}\r\n\t$.sidebarMenu($(\".sidebar-menu\"));\r\n\tvar frameIndex = 1;\r\n\tfunction showMenuErji(t) {\r\n\t\tvar code = $(t).data(\"code\");\r\n\t\t$(\"#main_title\").text($(t).find(\".maintext\").text());\r\n\t\t$(\".treeview\").each(function(i){\r\n\t\t\tif($(this).data(\"parent\") == code) {\r\n\t\t\t\t$(\".treeview\").removeClass(\"active\");\r\n\t\t\t\t$(\".treeview-menu\").hide();\r\n\t\t\t\t$(\".treeview-menu > li\").removeClass(\"active\");\r\n\t\t\t\t$(this).show();\r\n\t\t\t} else {\r\n\t\t\t\t$(this).hide();\r\n\t\t\t}\r\n\t\t});\r\n\t\tvar frameWidth = $(window).width()-175;\r\n\t\tvar framHeight = $(window).height()-$(\".tabs-wrap\").height()-$(\"#mainNorthPanle\").height()-5;\r\n\t\t$(\".firstLevelMenu\").slideUp(200);\r\n\t\t$(\"#mainContentPanle\").find(\"iframe\").hide();\r\n\t\t$(\"#mainContentPanle\").append(\"<iframe id='Frame\"+frameIndex+\"' name='Frame\"+frameIndex+\"' data-code='\"+code+\"' src='' style='border: 0; margin: 0; position:absolute;left:165px;height: 700px;'></iframe>\")\r\n\t\tvar title = $(\"span\", t).text();\r\n\t\tvar html = \"<li class=\\\"tabs-selected\\\" data-yjcode=\\\"\"+code+\"\\\" data-index=\\\"\"+frameIndex+\"\\\">\";\r\n\t\thtml += \"<a href=\\\"javascript:void(0)\\\" class=\\\"tabs-inner\\\" style=\\\"height: 26px; line-height: 26px;\\\" onclick=\\\"showMenu('\"+code+\"', '\"+frameIndex+\"', this)\\\">\";\r\n\t\thtml += \"<span class=\\\"tabs-title tabs-closable\\\">\"+title+\"</span>\";\r\n\t\thtml += \"</a><a href=\\\"javascript:void(0)\\\" class=\\\"tabs-close\\\" onclick=\\\"closeTag('\"+code+\"', '\"+frameIndex+\"', this)\\\"></a></li>\";\r\n\t\t$(\".tabs > li\").removeClass(\"tabs-selected\");\r\n\t\t$(\".tabs\").append(html);\r\n\t\t$(\"#Frame\"+frameIndex).width(frameWidth);\r\n\t\t$(\"#Frame\"+frameIndex).height(framHeight);\r\n\t\tframeIndex++;\r\n\t\trightMove();\r\n\t}\r\n\tfunction showMenuErji_bjkjdx(t) {\r\n\t\tvar code = $(t).data(\"code\");\r\n\t\t//$(\"#main_title\").text($(t).find(\".maintext\").text());\r\n\t\t/*$(\".treeview\").each(function(i){\r\n\t\t\tif($(this).data(\"parent\") == code) {\r\n\t\t\t\t$(\".treeview\").removeClass(\"active\");\r\n\t\t\t\t$(\".treeview-menu\").hide();\r\n\t\t\t\t$(\".treeview-menu > li\").removeClass(\"active\");\r\n\t\t\t\t$(this).show();\r\n\t\t\t} else {\r\n\t\t\t\t$(this).hide();\r\n\t\t\t}\r\n\t\t});*/\r\n\t\tvar frameWidth = $(window).width()-250;\r\n\t\tvar framHeight = $(window).height()-$(\".tabs-wrap\").height()-$(\"#mainNorthPanle\").height()-5;\r\n\t\t$(\".firstLevelMenu\").slideUp(200);\r\n\t\t$(\"#mainContentPanle\").find(\"iframe\").hide();\r\n\t\t$(\"#mainContentPanle\").append(\"<iframe id='Frame\"+frameIndex+\"' name='Frame\"+frameIndex+\"' data-code='\"+code+\"' src='' sty