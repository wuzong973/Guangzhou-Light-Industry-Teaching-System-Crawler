 {\r\n\t\t\t\t\t\t$(\".treeview-menu > li[data-sjcode='\"+prevObj.data(\"sjcode\")+\"']\", this).addClass(\"layui-this active\");\r\n\t\t\t\t\t}\r\n\t\t\t\t} else {\r\n\t\t\t\t\t$(this).hide();\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t}\r\n\t\tif(prevObj!=undefined){\r\n\t\t\tif(prevObj.data(\"index\") != \"0\") {\r\n\t\t\t\t$(\"#main_title\").text($(\".cy_icon > li[data-code='\"+prevObj.data(\"yjcode\")+\"']\").find(\".maintext\").text());\r\n\t\t\t} else {\r\n\t\t\t\t$(\"#main_title\").text(\"主菜单\");\r\n\t\t\t}\r\n\t\t}\r\n\t\t$(\"#Frame\"+index).remove();\r\n\t\t$(t).parent(\"li\").remove();\r\n\t\trightMove();\r\n\t}\r\n\tfunction closeTag(code, index, t) {\r\n\t\tif($(t).parent(\"li\").hasClass(\"tabs-selected\")) {\r\n\t\t\tvar prevObj = $(t).parent(\"li\").prev(\"li\");\r\n\t\t\t$(\"#Frame\"+prevObj.data(\"index\")).show();\r\n\t\t\tprevObj.addClass(\"tabs-selected\");\r\n\t\t\t$(\".treeview\").each(function(i){\r\n\t\t\t\tif($(this).data(\"parent\") == prevObj.data(\"yjcode\")) {\r\n\t\t\t\t\t$(this).show();\r\n\t\t\t\t\t$(this).removeClass(\"active\").show().find(\".treeview-menu\").hide();\r\n\t\t\t\t\t$(\".treeview-menu > li\", this).removeClass(\"active\");\r\n\t\t\t\t\tif(prevObj.data(\"ejcode\") == $(this).data(\"code\")) {\r\n\t\t\t\t\t\t$(this).addClass(\"active\");\r\n\t\t\t\t\t\t$(\".treeview-menu\", this).show();\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif(prevObj.data(\"sjcode\")) {\r\n\t\t\t\t\t\t$(\".treeview-menu > li[data-sjcode='\"+prevObj.data(\"sjcode\")+\"']\", this).addClass(\"active\");\r\n\t\t\t\t\t}\r\n\t\t\t\t} else {\r\n\t\t\t\t\t$(this).hide();\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t}\r\n\t\tif(prevObj!=undefined){\r\n\t\t\tif(prevObj.data(\"index\") != \"0\") {\r\n\t\t\t\t$(\"#main_title\").text($(\".cy_icon > li[data-code='\"+prevObj.data(\"yjcode\")+\"']\").find(\".maintext\").text());\r\n\t\t\t} else {\r\n\t\t\t\t$(\"#main_title\").text(\"主菜单\");\r\n\t\t\t}\r\n\t\t}\r\n\t\t$(\"#Frame\"+index).remove();\r\n\t\t$(t).parent(\"li\").remove();\r\n\t\t//rightMove();\r\n\t}\r\n\tfunction leftMove() {\r\n\t\t$(\".tabs-wrap\").css({left: 0});\r\n\t}\r\n\tfunction rightMove() {\r\n\t\tvar _width = $(\"#mainTagPanle\").width() - 18 * 2 - 4;\r\n\t\tvar outWidth = 0;\r\n\t\t$(\".tabs > li\").each(function(e){\r\n\t\t\toutWidth += $(this).outerWidth(true);\r\n\t\t});\r\n\t\tif(outWidth > _width) {\r\n\t\t\t$(\".tabs-wrap\").width(outWidth + 4);\r\n\t\t\t$(\".tabs-wrap\").css({left: (_width - outWidth+20)});\r\n\t\t} else {\r\n\t\t\t$(\".tabs-wrap\").width($(\"#mainTagPanle\").width());\r\n\t\t}\r\n\t}\r\n\tfunction showMenu_bjkjdx(code, index, t) {\r\n\r\n\t\t$(\".treeview\").each(function(i){\r\n\t\t\tif($(this).data(\"parent\") == code) {\r\n\t\t\t\t$(this).removeClass(\"active\").show().find(\".treeview-menu\").hide();\r\n\t\t\t\t$(\".treeview-menu > li\", this).removeClass(\"active\");\r\n\t\t\t\tif($(t).parent(\"li\").data(\"ejcode\") == $(this).data(\"code\")) {\r\n\t\t\t\t\t$(this).addClass(\"active\");\r\n\t\t\t\t\t$(\".treeview-menu\", this).show();\r\n\t\t\t\t}\r\n\t\t\t\tif($(t).parent(\"li\").data(\"sjcode\")) {\r\n\t\t\t\t\t$(\".treeview-menu > li[data-sjcode='\"+$(t).parent(\"li\").data(\"sjcode\")+\"']\", this).addClass(\"active\");\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\t$(this).hide();\r\n\t\t\t}\r\n\t\t});\r\n\t\tif(index != 0) {\r\n\t\t\t$(\"#main_title\").text($(\".cy_icon > li[data-code='\"+code+\"']\").find(\".maintext\").text());\r\n\t\t} else {\r\n\t\t\t$(\"#main_title\").text(\"主菜单\");\r\n\t\t}\r\n\t\t$(\"#mainContentPanle\").find(\"iframe\").hide();\r\n\t\t$(\"#Frame\"+index).show();\r\n\t\t$(\".layui-tab-title > li\").removeClass(\"ffc\");\r\n\t\t$(t).parent(\"li\").addClass(\"ffc\");\r\n\t}\r\n\tfunction showMenu(code, index, t) {\r\n\r\n\t\t$(\".treeview\").each(function(i){\r\n\t\t\tif($(this).data(\"parent\") == code) {\r\n\t\t\t\t$(this).removeClass(\"active\").show().find(\".treeview-menu\").hide();\r\n\t\t\t\t$(\".treeview-menu > li\", this).removeClass(\"active\");\r\n\t\t\t\tif($(t).parent(\